{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@tsconfig/bases/strictest", "@tsconfig/bases/vite-react"],
  "compilerOptions": {
    "composite": true,
    "declarationDir": "./node_modules/.tmp/types/engine",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noUncheckedIndexedAccess": false,
    "tsBuildInfoFile": "./node_modules/.tmp/engine.tsbuildinfo"
  },
  "include": [
    "src/audio",
    "src/content",
    "src/game",
    "src/generation",
    "src/models",
    "src/rendering",
    "src/shared",
    "src/simulation",
    "src/workers",
    "src/world"
  ]
}
