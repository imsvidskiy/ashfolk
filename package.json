{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "ashfolk",
  "version": "0.10.0",
  "private": true,
  "description": "A god simulator about the first tribes on a floating island",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "ultracite check",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "shots": "bun tests/shoot-scenes.ts",
    "sounds": "bun scripts/encode-sounds.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.63.0",
    "pure-rand": "^8.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.154.0"
  }
}
